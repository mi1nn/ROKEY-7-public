  <diagram id="amr2-control" name="05 PC2 자동 지원·명령·주행" placementVariant="three_pc" basisPage="00 통합 시스템 설계도_PC3대" scenarioRevision="PM-20261013-FIELD_RECHECK_REQUIRED">
  <mxGraphModel grid="0" gridSize="10" page="1" pageScale="1" pageWidth="2600" pageHeight="11510" background="#FFFFFF" guides="1" connect="1" arrows="1" fold="0">
    <root>
      <mxCell id="0" />
      <mxCell id="1" parent="0" />
      <object id="title-amr2-control" label="05 PC2 자동 지원·명령·주행">
        <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Apple SD Gothic Neo;fontSize=12;spacing=6;fillColor=#FFFFFF;strokeColor=#CAD5E3;fontSize=22;fontStyle=1;fillColor=none;strokeColor=none;">
          <mxGeometry x="30" y="20" width="2540" height="55" as="geometry" />
        </mxCell>
      </object>
      <object id="basis-amr2-control" label="2026-10-13 PM 설계 요구안 · 기준 00 통합 시스템 설계도_PC3대 · 응용 PC3 + Discovery PC4 = 총4대 · 실행/배포/E3/E4 미검증">
        <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Apple SD Gothic Neo;fontSize=12;spacing=6;fillColor=#FFFFFF;strokeColor=#CAD5E3;fontSize=12;fillColor=none;strokeColor=none;">
          <mxGeometry x="30" y="90" width="2540" height="50" as="geometry" />
        </mxCell>
      </object>
      <object id="legend-amr2-control" label="[T] 파랑 / [S] 초록 / [A] 보라 / HTTP 주황 / SQL·LOCAL 회색 / DISCOVERY 연회색 점선&#10;Topic=PUB→SUB, Service/Action=client→server(응답·Feedback·Result는 역방향). 반복 박스는 같은 논리 노드.">
        <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Apple SD Gothic Neo;fontSize=12;spacing=6;fillColor=#FFFFFF;strokeColor=#CAD5E3;fontSize=11;fillColor=none;strokeColor=none;">
          <mxGeometry x="30" y="150" width="2540" height="60" as="geometry" />
        </mxCell>
      </object>
      <object id="flow-amr2-control" label="유효 대상·좌표 + PERSISTED → coordinator 자동 배정 → executor admission/lease/readiness → 경로/통로 검증 → Nav2 접근.&#10;사람은 AMR2 뒤를 따름. 초기 출동 승인/구간 ‘계속’은 새 요구의 필수 흐름에서 제외. 기존 guard를 우회하거나 승인을 위조하지 않음.&#10;RGB-D 경로 전체 폭/바닥/상부 여유 → PASSABLE/BLOCKED/UNKNOWN. UNKNOWN이면 진입 보류. 도착·정지·인형 재탐지 → exit_ref 도착·정지 종료(매핑 미정)." kind="FUNCTION_FLOW_NOTE">
        <mxCell parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Apple SD Gothic Neo;fontSize=12;spacing=6;fillColor=#FFFFFF;strokeColor=#CAD5E3;fillColor=#FFF8DD;align=left;">
          <mxGeometry x="30" y="230" width="2540" height="120" as="geometry" />
        </mxCell>
