        </mxCell>
        <mxCell id="overview-state-note" value="지진 이벤트 → AMR1 수색 → 좌표 확정 → 사람 승인 → AMR2 한 구간 이동 → 소실 후보 → AMR1 재확인 → 완료 / 복귀" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontFamily=Apple SD Gothic Neo;fontSize=22;fontColor=#18263C;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1320" width="1760" height="64" as="geometry" />
        </mxCell>
        <mxCell id="overview-footer" value="전체도는 대표 흐름만 표시합니다. 실제 데이터는 DDS 참여자 사이로 전달되고 Discovery Server는 발견 메타데이터만 처리합니다.&#10;AMR 탑재 watchdog와 RGB-D의 실제 구성은 [미확인]; PC1/PC2/PC3/PC4 명칭은 배치 역할의 예시입니다." style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CAD5E3;strokeWidth=1.5;fontFamily=Apple SD Gothic Neo;fontSize=17;fontColor=#18263C;fontStyle=0;align=center;verticalAlign=middle;spacing=8;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=top;connectable=0;" vertex="1" parent="1">
          <mxGeometry x="36" y="1423" width="1768" height="74" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
