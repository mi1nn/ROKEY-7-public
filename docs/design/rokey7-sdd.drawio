  <diagram id="amr2-skeleton-requirement" name="11 AMR2 연속 추종 요구">
    <mxGraphModel dx="1400" dy="1000" grid="0" gridSize="10" page="1" pageScale="1" pageWidth="1440" pageHeight="1140" background="#F6F8FC">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sk-title" value="AMR2 · 출동 승인 후 카메라 다리 스켈레톤으로 목적지까지 연속 추종" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#8CA0BA;fontFamily=Apple SD Gothic Neo;fontSize=25;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1370" height="65" as="geometry" />
        </mxCell>
        <mxCell id="sk-subtitle" value="사용자 요구 2026-10-11 · scope RQ-10 / Q-27 · contracts C-12&#10;점선은 요구 데이터 흐름: ROS 토픽·서비스·액션과 모델은 미정, 실제 배선·추종 구현 없음" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#8CA0BA;fontFamily=Apple SD Gothic Neo;fontSize=17;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="100" width="1370" height="80" as="geometry" />
