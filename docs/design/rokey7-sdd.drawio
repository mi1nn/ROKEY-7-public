        <mxCell id="amr2-data-subtitle" value="반복된 노드 박스 = 동일한 논리 노드 · 왼쪽 포트가 정확한 이름·타입 정의 · 색 선은 실제 발행/구독 또는 client/server 관계" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CAD5E3;strokeWidth=1.5;fontFamily=Apple SD Gothic Neo;fontSize=18;fontColor=#18263C;fontStyle=0;align=center;verticalAlign=middle;spacing=8;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=top;connectable=0;" vertex="1" parent="1">
