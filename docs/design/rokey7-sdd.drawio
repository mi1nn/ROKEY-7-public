        <mxCell id="-Z1KHjeIQYwDz-NqSXR9-78" parent="-Z1KHjeIQYwDz-NqSXR9-1" style="text;whiteSpace=wrap;html=0;fontFamily=Apple SD Gothic Neo;fontSize=20;fontColor=#18263C;align=left;verticalAlign=middle;spacing=4;fillColor=none;strokeColor=none;" value="범례 · 기준과 미검증" vertex="1">
          <mxGeometry height="40" width="740" x="4780" y="3480" as="geometry" />
