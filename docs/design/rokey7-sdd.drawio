        <mxCell id="sk-person" value="실제 구조대원&#10;사람이 앞서 걷고 AMR2가 뒤따름&#10;요구조자 인형과 구분" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF2FD;strokeColor=#8CA0BA;fontFamily=Apple SD Gothic Neo;fontSize=17;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
