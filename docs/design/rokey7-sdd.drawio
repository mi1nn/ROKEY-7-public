        </mxCell>
        <mxCell id="sk-pc2" value="PC2 · AMR2 인식·추종 실행 책임 [요구, 미구현]" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EEF3FC;strokeColor=#8CA0BA;fontFamily=Apple SD Gothic Neo;fontSize=17;align=center;verticalAlign=middle;spacing=10;align=left;verticalAlign=top;spacingTop=18;spacingLeft=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="405" y="215" width="590" height="555" as="geometry" />
        </mxCell>
        <mxCell id="sk-pose" value="다리 스켈레톤 인식&#10;키포인트·동일 추종 대상·관측 유효성&#10;모델 / ROS 입력 타입 미정(Q-27)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#8CA0BA;fontFamily=Apple SD Gothic Neo;fontSize=17;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="435" y="285" width="530" height="125" as="geometry" />
        </mxCell>
        <mxCell id="sk-executor" value="rescue_robot 실행 경계&#10;유효 관측·거리·허용 경로·권한 확인&#10;활성 이동 1개 / 이동·취소·정지의 유일 발행자&#10;추종 액션·주행 방식 미정(Q-27)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#8CA0BA;fontFamily=Apple SD Gothic Neo;fontSize=17;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="435" y="480" width="530" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sk-stop" value="취소 → 실제 정지 확인 → 사유 보고&#10;가림·소실·관측 만료·거리 불확실·위험&#10;자동 사람 전환·자동 재시작 금지 [제안]" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF1E7;strokeColor=#8CA0BA;fontFamily=Apple SD Gothic Neo;fontSize=15;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="435" y="675" width="530" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sk-approval" value="PC4 · 웹 / operations / coordinator&#10;출동 승인 1회 + 목적지·허용 범위&#10;구간별 ‘계속’ 승인 없음" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E9F7EF;strokeColor=#8CA0BA;fontFamily=Apple SD Gothic Neo;fontSize=17;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1055" y="225" width="340" height="125" as="geometry" />
        </mxCell>
        <mxCell id="sk-motion" value="AMR2 구동&#10;사람 뒤에서 저속 연속 추종&#10;Nav2 출력과 추종 출력 동시 발행 금지" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF2FD;strokeColor=#8CA0BA;fontFamily=Apple SD Gothic Neo;fontSize=17;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1055" y="480" width="340" height="135" as="geometry" />
        </mxCell>
        <mxCell id="sk-arrival" value="목적지 도착·실제 정지&#10;AMR2 카메라로 인형 재탐지&#10;웹캠 소실 후보 → AMR1 재확인" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E9F7EF;strokeColor=#8CA0BA;fontFamily=Apple SD Gothic Neo;fontSize=17;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1055" y="680" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="sk-footer" value="구간 이동의 MOVE_SEGMENT / CONTINUE_SEGMENT / ONE_SEGMENT는 01–10쪽의 기존 계약이다. 연속 추종 구현으로 재사용하지 않는다.&#10;정지 후 재시작은 원인 해소·정지 확인·새 승인/명령 필요 [제안]. 깊이·거리/TF 보정·추종 액션·종료/취소·검증 기준은 Q-27 후속이다.&#10;E3 ROS 연결 / E4 사람 추종·정지: NOT_RUN. 현장 정지 수단은 웹 연결에만 의존하지 않는다." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#8CA0BA;fontFamily=Apple SD Gothic Neo;fontSize=16;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="955" width="1370" height="125" as="geometry" />
        </mxCell>
