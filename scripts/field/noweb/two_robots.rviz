Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Map
      Name: TB-6 SLAM map
      Enabled: true
      Value: true
      Alpha: 0.7
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /robot6/map
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Update Topic:
        Value: /robot6/map_updates
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Map
      Name: Frozen map
      Enabled: true
      Value: true
      Alpha: 0.5
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Value: /rescue/map/frozen
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/RobotModel
      Name: TB-6 model
      Enabled: true
      Value: true
      Description Source: Topic
      Description Topic:
        Value: /robot6/robot_description
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz_default_plugins/LaserScan
      Name: TB-6 scan
      Enabled: true
      Value: true
      Topic:
        Value: /robot6/scan
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 80; 80
      Position Transformer: XYZ
    - Class: rviz_default_plugins/Path
      Name: TB-6 plan
      Enabled: true
      Value: true
      Topic:
        Value: /robot6/plan
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Line Style: Lines
      Line Width: 0.03
      Color: 0; 220; 80
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: TB-5 pose (AMCL)
      Enabled: true
      Value: true
      Topic:
        Value: /robot5/amcl_pose
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Shape: Arrow
      Color: 80; 160; 255
      Covariance:
        Value: true
    - Class: rviz_default_plugins/Path
      Name: TB-5 plan
      Enabled: true
      Value: true
      Topic:
        Value: /robot5/plan
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Line Style: Lines
      Line Width: 0.03
      Color: 80; 160; 255
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 70
      X: 0
      Y: 0
      Angle: 0
      Target Frame: map
Window Geometry:
  Width: 1200
  Height: 800
