Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Value: true
      Alpha: 1
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /robot6/map
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Update Topic:
        Value: /robot6/map_updates
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Value: true
      Description Source: Topic
      Description Topic:
        Value: /robot6/robot_description
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz_default_plugins/LaserScan
      Name: Scan
      Enabled: true
      Value: true
      Topic:
        Value: /robot6/scan
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 80; 80
      Position Transformer: XYZ
    - Class: rviz_default_plugins/Path
      Name: Search path
      Enabled: true
      Value: true
      Topic:
        Value: /robot6/plan
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Line Style: Lines
      Line Width: 0.03
      Color: 0; 220; 80
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /robot6/initialpose
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /rescue/search_goal
        Reliability Policy: Reliable
        Durability Policy: Volatile
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 70
      X: 0
      Y: 0
      Angle: 0
      Target Frame: map
Window Geometry:
  Width: 1200
  Height: 800
