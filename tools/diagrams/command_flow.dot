digraph G {
  rankdir=TB; nodesep=0.5; ranksep=0.45;
  graph [fontname="Noto Sans CJK KR", fontsize=14, dpi=150, pad=0.3, bgcolor="white"];
  node [fontname="Noto Sans CJK KR", fontsize=12, shape=box, style="rounded,filled", fillcolor="#F4F6F8", color="#5B6770", penwidth=1.2];
  edge [fontname="Noto Sans CJK KR", fontsize=10, color="#5B6770", arrowsize=0.8];
  W [label="관제 웹\n운영자 명령", fillcolor="#FDEBD0"];
  CAM [label="웹캠 판정\nSiteEvent", fillcolor="#FFF3CD"];
  DB [label="db_writer\n명령 API · 현장 상태 DB"];
  C [label="임무 조정기\nmission_coordinator\n(임무를 정하는 곳은 하나)", fillcolor="#D5F5E3"];
  T [label="실행기 task_input\n(Nav2 목표를 보내는 곳은 하나)", fillcolor="#D6EAF8"];
  N [label="Nav2\n+ 통로 정지·감속"];
  WD [label="command_watchdog\n(속도 명령은 이 노드만)\n만료·stop fence", fillcolor="#F5B7B1"];
  R [label="TurtleBot4\nCreate 3 · cmd_vel", shape=box, fillcolor="#D6EAF8"];
  ST [label="정지 판정\n취소 → 실제 정지 관측\n못 하면 STOP_UNCONFIRMED", shape=note, fillcolor="#FEF9E7"];
  W -> DB [label="HTTP POST\n/api/operator-commands"];
  DB -> C [label="SubmitOperatorCommand"];
  CAM -> C [label="/rescue/site_events"];
  C -> T [label="ExecuteTask action\n+ lease(명령 권한)"];
  T -> N [label="NavigateToPose"];
  N -> WD [label="cmd_vel"];
  WD -> R [label="속도 명령"];
  R -> T [label="status · pose", style=dashed, constraint=false];
  T -> C [label="상태 · 결과", style=dashed, constraint=false];
  T -> ST [style=dotted, arrowhead=none];
}
