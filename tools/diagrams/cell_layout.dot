digraph G {
  rankdir=LR; nodesep=0.5; ranksep=0.8; newrank=true;
  graph [fontname="Noto Sans CJK KR", fontsize=13, dpi=150, pad=0.3, bgcolor="white", labelloc=b,
         label="개념도: 요소와 순서만 나타내며 치수·실제 위치는 나타내지 않는다."];
  node [fontname="Noto Sans CJK KR", fontsize=12, shape=box, style="rounded,filled", fillcolor="#F4F6F8", color="#5B6770", penwidth=1.2];
  edge [fontname="Noto Sans CJK KR", fontsize=10, color="#5B6770", arrowsize=0.8];
  CAM [label="고정 웹캠\nDRGO WC720\n(현장 감시)", fillcolor="#FFF3CD"];
  subgraph cluster_site { label="재난 모사 현장 (실내)"; style="rounded,filled"; fillcolor="#FBFCFC"; color="#B9770E"; fontsize=13;
    DOCK [label="TB-6 도킹 접근 지점\n(탐색 뒤 복귀, 도킹은 사람)", fillcolor="#D6EAF8"];
    WAIT [label="TB-5 대기 자리\n(QR 출구가 없으면 출구)", fillcolor="#D6EAF8"];
    AREA [label="탐색 구역\n(실내 벽 · 통로)", fillcolor="#EAECEE"];
    PASS [label="머리 위 기둥 통로\n여유 46 cm 이상이면 통과", fillcolor="#F5B7B1"];
    DOLL [label="구조 대상 인형", fillcolor="#FFF3CD"];
    EXIT [label="출구 QR\nEXIT-1 · EXIT-2 …", fillcolor="#D5F5E3"];
  }
  DOCK -> AREA [label="TB-6 탐색"];
  AREA -> PASS [dir=none, style=dashed];
  AREA -> DOLL [dir=none, style=dashed];
  WAIT -> DOLL [label="TB-5 출동"];
  DOLL -> EXIT [label="TB-5 + 구조대원 이동"];
  CAM -> AREA [style=dotted, label="감시"];
}
