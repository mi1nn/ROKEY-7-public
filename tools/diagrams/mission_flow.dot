digraph G {
  rankdir=TB; nodesep=0.35; ranksep=0.45;
  graph [fontname="Noto Sans CJK KR", fontsize=14, dpi=150, pad=0.3, bgcolor="white"];
  node [fontname="Noto Sans CJK KR", fontsize=12, shape=box, style="rounded,filled", fillcolor="#F4F6F8", color="#5B6770", penwidth=1.2];
  edge [fontname="Noto Sans CJK KR", fontsize=10, color="#5B6770", arrowsize=0.8];
  S [label="시작", shape=oval, fillcolor="#EAECEE"];
  A [label="1 고정 웹캠이 지진 징후(DISASTER_SIGN) 판정\n운영자 버튼 없이 탐색 시작", fillcolor="#FFF3CD"];
  B [label="2 TB-6 탐색\nSLAM 으로 지도 작성 + frontier 이동\n탐색 중 출구 QR 기록 (EXIT-1, EXIT-2 …)", fillcolor="#D6EAF8"];
  C [label="인형 확정?", shape=diamond, fillcolor="#FDEBD0"];
  D [label="3 보고 저장 (PERSISTED)\n→ 1차 지도 고정", fillcolor="#D5F5E3"];
  E [label="4 TB-5 자동 출동\n인형 앞 접근 지점에서 대기", fillcolor="#D6EAF8"];
  F [label="탐색 완료?\n(더 갈 frontier 없음)", shape=diamond, fillcolor="#FDEBD0"];
  G [label="5 2차 지도 고정\nTB-6 는 SLAM → AMCL 로 전환\nTB-5 는 멈춘 채 완성 지도에 다시 위치를 맞춤", fillcolor="#D5F5E3"];
  H [label="6 TB-5 가 인형에서 가장 가까운 출구로\n사람을 이끌고 이동\nQR 출구가 없으면 TB-5 출발 자리가 출구", fillcolor="#D6EAF8"];
  I [label="TB-5 출구 도착 = 구출 확인\nTB-6 는 도킹 접근 지점으로", fillcolor="#D6EAF8"];
  J [label="MISSION_FINISHED", shape=oval, fillcolor="#D5F5E3"];
  N [label="인형 없음 → TB-5 출발하지 않음\nNO_SURVIVOR_FOUND", shape=oval, fillcolor="#F5B7B1"];
  X [label="통로 · 터널 구간: 머리 위 여유 46 cm 이상이면 통과\n미만이거나 판정 불가면 멈추고 보고\n위치·지도·시각을 모르면 새 명령 차단", shape=note, fillcolor="#FEF9E7"];
  S -> A -> B -> C;
  C -> D [label="예"]; D -> E; E -> F; B -> F [style=invis];
  C -> F [label="아니오"];
  F -> B [label="아니오 (탐색 계속)", constraint=false];
  F -> G [label="예"];
  G -> H [label="인형 있음"]; G -> N [label="인형 없음"];
  H -> I -> J;
  H -> X [style=dotted, arrowhead=none];
}
