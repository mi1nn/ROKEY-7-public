digraph G {
  rankdir=LR; nodesep=0.3; ranksep=0.5;
  graph [fontname="Noto Sans CJK KR", fontsize=14, dpi=150, pad=0.3, bgcolor="white"];
  node [fontname="Noto Sans CJK KR", fontsize=12, shape=box, style="rounded,filled", fillcolor="#F4F6F8", color="#5B6770", penwidth=1.2];
  edge [fontname="Noto Sans CJK KR", fontsize=10, color="#5B6770", arrowsize=0.8];
  S6 [label="TB-6 SLAM\n/robot6/map (실시간 지도)", fillcolor="#D6EAF8"];
  C [label="임무 조정기", fillcolor="#D5F5E3"];
  F [label="지도 고정\nmap_freeze\n(한 회차에 두 번까지)", fillcolor="#FDEBD0"];
  R1 [label="고정 지도 판 1 (R0+1)\n인형 확정 + 보고 저장 뒤", fillcolor="#EAF2F8"];
  R2 [label="고정 지도 판 2 (R0+2)\n탐색 완료 뒤 (완성 지도)", fillcolor="#EAF2F8"];
  T5 [label="TB-5 AMCL\n출발 자리 기준 위치 추정", fillcolor="#D6EAF8"];
  T6 [label="TB-6\nSLAM 을 끄고 AMCL 로 전환\n(사람이 전환)", fillcolor="#D6EAF8"];
  S6 -> C [label="탐색 경계 · 인형 위치"];
  C -> F [label="고정 요청\n(TB-6 정지 상태)"];
  F -> R1 [label="1차 고정"]; R1 -> T5 [label="TB-5 출동"];
  F -> R2 [label="2차 고정"];
  R2 -> T5 [label="멈춘 채 위치 다시 맞춤"];
  R2 -> T6 [label="고정 자세"];
  F -> X [label="세 번째 요청", style=dashed, color="#C0392B", fontcolor="#C0392B"];
  X [label="거절", shape=oval, fillcolor="#F5B7B1"];
}
